{
  "name": "@anthropic-ai/claude-code",
  "version": "1.0.0-local",
  "description": "Claude Code CLI - AI-powered coding assistant",
  "type": "module",
  "main": "dist/entrypoints/cli.js",
  "bin": {
    "claude": "dist/entrypoints/cli.js"
  },
  "scripts": {
    "build": "bun run build:bundle",
    "build:bundle": "bun run scripts/build.ts",
    "build:dev": "bun run scripts/build.ts --dev",
    "dev": "bun run --watch entrypoints/cli.tsx",
    "start": "bun run entrypoints/cli.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "bun test",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "postinstall": "echo 'Note: This is a local build from source. Some features may not work.'"
  },
